void main() {
	audio_decoder d;
	if(!d.open(file("../data/audio/points.ogg", "rb"))) {
		alert("can't open", "audio_decoder could not open points.ogg");
		exit();
	}
	sound s;
	s.push_memory(d.read(1024 * 256), true, d.sample_rate, d.channels);
	s.play_wait();
}
