// Tests for the SDL3 + Steam Audio sound engine, which lives in the steam namespace until it replaces the MiniAudio one.
// Every yfs file is the same 1.634 second clip in a different format.
const string[] steam_sound_formats = {"data/audio/yfs.ogg", "data/audio/yfs.wav", "data/audio/yfs.mp3", "data/audio/yfs.flac", "data/audio/yfs.opus", "data/audio/yfs_mono22k.wav"};

void test_steam_sound_decodes_every_format() {
	for (uint i = 0; i < steam_sound_formats.length(); i++) {
		steam::sound s;
		assert(s.load(steam_sound_formats[i]), "load " + steam_sound_formats[i]);
		assert(s.loaded_filename == steam_sound_formats[i]);
		assert(abs(s.length - 1634) < 60, steam_sound_formats[i] + " length " + s.length);
		steam::sound st;
		assert(st.stream(steam_sound_formats[i]), "stream " + steam_sound_formats[i]);
		assert(abs(st.length - 1634) < 60, "streamed " + steam_sound_formats[i] + " length " + st.length);
	}
}

// 441.ogg is 25.25 seconds of 48 kHz stereo music: load decodes it all, stream decodes it on the feeder thread.
void test_steam_sound_music_load_and_stream_agree() {
	steam::sound loaded, streamed;
	assert(loaded.load("data/audio/441.ogg"));
	assert(streamed.stream("data/audio/441.ogg"));
	assert(abs(loaded.length - 25254) < 30, "loaded length " + loaded.length);
	assert(abs(streamed.length - 25254) < 30, "streamed length " + streamed.length);
	assert(loaded.seek(20000) && streamed.seek(20000));
	assert(abs(loaded.position - 20000) < 30, "loaded position " + loaded.position);
	assert(abs(streamed.position - 20000) < 30, "streamed position " + streamed.position);
	assert(!streamed.seek(-5));
}

void test_steam_sound_music_stream_loops_through_the_end() {
	if (!steam::SOUND_AVAILABLE) return;
	steam::mixer m;
	m.volume = -100;
	steam::sound s;
	assert(s.set_mixer(m));
	assert(s.stream("data/audio/441.ogg"));
	assert(s.play_looped());
	assert(s.seek(24500)); // Three quarters of a second from the end.
	wait(1500);
	assert(s.playing, "looped music stopped at the end");
	assert(s.position < 2000, "position after wrapping " + s.position);
	assert(s.pause());
	float paused_at = s.position;
	wait(300);
	assert(abs(s.position - paused_at) < 1, "position moved while paused");
}

void test_steam_sound_rejects_missing_and_garbage() {
	steam::sound s;
	assert(!s.load("data/audio/does_not_exist.ogg"));
	assert(!s.stream("data/audio/does_not_exist.ogg"));
	assert(!s.active);
	file f;
	f.open("tmp/steam_sound_garbage.bin", "wb");
	f.write("this is not audio, and no decoder should claim that it is.");
	f.close();
	assert(!s.load("tmp/steam_sound_garbage.bin"));
}

void test_steam_sound_play_state() {
	steam::sound s;
	assert(!s.play()); // Nothing loaded.
	assert(s.load("data/audio/yfs.ogg"));
	assert(s.active);
	assert(s.paused); // A freshly loaded sound sits paused in its mixer, as under BASS.
	assert(!s.playing);
	assert(s.play());
	assert(s.playing && !s.paused);
	assert(!s.play()); // Already playing.
	assert(s.pause());
	assert(!s.playing && s.paused);
	assert(!s.pause()); // Already paused.
	assert(s.seek(800));
	assert(abs(s.position - 800) < 5);
	assert(s.stop());
	assert(s.position == 0);
	assert(s.close());
	assert(!s.active && s.loaded_filename == "");
	assert(!s.close());
}

void test_steam_sound_parameter_ranges() {
	steam::sound s;
	assert(s.load("data/audio/yfs.ogg"));
	s.volume = 5;
	assert(s.volume == 0); // Volume clamps to -100..0 like the legacy engine.
	s.volume = -150;
	assert(s.volume == -100);
	assert(!s.slide_volume(-101, 100));
	s.pan = 40;
	s.pan = 150; // Out of range, ignored.
	assert(s.pan == 40);
	s.pitch = 200;
	s.pitch = 1; // Below the 5 percent floor, ignored.
	assert(s.pitch == 200);
	assert(!s.slide_pitch(600, 100));
	assert(s.slide_pan(-40, 100000));
	assert(s.pan_sliding && s.sliding && !s.volume_sliding);
}

void test_steam_mixer_tree_refuses_cycles() {
	steam::mixer a, b, c;
	assert(b.set_mixer(a));
	assert(c.set_mixer(b));
	assert(!a.set_mixer(c)); // c is inside a.
	assert(!a.set_mixer(a));
	assert(a.set_mixer(null)); // Back to the master.
	steam::sound s;
	assert(s.set_mixer(c));
	assert(s.load("data/audio/yfs.ogg"));
	assert(s.active);
}

void test_steam_sound_plays_through_device() {
	if (!steam::SOUND_AVAILABLE) return; // Nothing to drive the clock on a machine without an output device.
	steam::mixer m;
	m.volume = -100; // Silent, this only checks that time passes.
	steam::sound s;
	assert(s.set_mixer(m));
	assert(s.load("data/audio/yfs.ogg"));
	assert(s.play());
	wait(300);
	assert(s.position > 150, "position " + s.position);
	timer t;
	while (s.playing && t.elapsed < 4000) wait(10);
	assert(!s.playing, "sound never finished");
	assert(!s.paused); // It ended rather than being paused.
	assert(s.play()); // Playing an ended sound starts it over.
	assert(s.position < 300);
	s.stop();
	steam::sound looped;
	assert(looped.set_mixer(m));
	assert(looped.stream("data/audio/yfs_mono22k.wav"));
	assert(looped.play_looped());
	wait(2200); // Past the end of the clip.
	assert(looped.playing, "looped stream stopped");
	steam::sound fast;
	assert(fast.set_mixer(m));
	assert(fast.load("data/audio/yfs.wav"));
	fast.pitch = 400;
	assert(fast.play());
	t.restart();
	while (fast.playing && t.elapsed < 4000) wait(10);
	assert(t.elapsed < 1000, "pitch 400 took " + t.elapsed + "ms to play 1634ms of audio");
}

// Phase 2 data sources.
string steam_read_file(const string&in path) {
	file f;
	if (!f.open(path, "rb")) return "";
	string data = f.read();
	f.close();
	return data;
}

void test_steam_sound_legacy_pack() {
	steam::pack p;
	assert(p.open("tmp/steam_legacy.dat", steam::PACK_OPEN_MODE_CREATE));
	assert(p.add_file("data/audio/yfs.ogg", "yfs.ogg"));
	assert(p.add_file("data/audio/441.ogg", "music.ogg"));
	assert(p.close());
	assert(p.open("tmp/steam_legacy.dat", steam::PACK_OPEN_MODE_READ));
	steam::sound s;
	assert(s.load("yfs.ogg", p));
	assert(abs(s.length - 1634) < 60, "length " + s.length);
	assert(s.stream("music.ogg", p)); // Long enough to stream rather than decode.
	assert(abs(s.length - 25254) < 30, "streamed from pack " + s.length);
	assert(!s.load("missing.ogg", p));
	@steam::sound_default_pack = p;
	assert(s.load("yfs.ogg")); // Picked up from the default pack.
	assert(@steam::sound_default_pack != null);
	@steam::sound_default_pack = null;
	assert(!s.load("yfs.ogg")); // Not on disk.
	assert(s.load("data/audio/yfs.ogg"));
}

void test_steam_sound_modern_pack() {
	pack_file p;
	assert(p.create("tmp/steam_modern.dat"));
	assert(p.add_file("data/audio/yfs.wav", "yfs.wav"));
	assert(p.close());
	assert(p.open("tmp/steam_modern.dat"));
	steam::sound s;
	assert(s.load("yfs.wav", p));
	assert(abs(s.length - 1634) < 60, "length " + s.length);
	// The same name on disk is a different file and must not come back from the cache.
	assert(!s.load("yfs.wav", null));
}

void test_steam_sound_load_from_memory() {
	string data = steam_read_file("data/audio/yfs.ogg");
	assert(data.length() > 0);
	steam::sound s;
	assert(s.load(data, data.length()));
	assert(s.loaded_filename == "script_stream");
	assert(abs(s.length - 1634) < 60);
	string scrambled;
	for (uint i = 0; i < data.length(); i++) scrambled += ascii_to_character(character_to_ascii(data[i]) + 27); // The inverse of the default sound_data_char_decrypt.
	assert(scrambled.length() == data.length() && scrambled != data);
	assert(s.load(scrambled, scrambled.length(), "scrambled.ogg", true));
	assert(s.loaded_filename == "scrambled.ogg");
	assert(abs(s.length - 1634) < 60);
	assert(!s.load(scrambled, scrambled.length())); // Without decrypting it is noise.
}

string steam_callback_source;
uint steam_callback_pos;
bool steam_callback_closed;
uint steam_cb_length(string user_data) { return steam_callback_source.length(); }
int steam_cb_read(string &out data, uint length, string user_data) {
	assert(user_data == "callback data");
	data = steam_callback_source.substr(steam_callback_pos, length);
	steam_callback_pos += data.length();
	return data.length();
}
bool steam_cb_seek(uint offset, string user_data) {
	steam_callback_pos = offset;
	return true;
}
void steam_cb_close(string user_data) { steam_callback_closed = true; }
void test_steam_sound_load_from_callbacks() {
	steam_callback_source = steam_read_file("data/audio/yfs.mp3");
	steam_callback_pos = 0;
	steam_callback_closed = false;
	steam::sound s;
	assert(s.load(steam_cb_close, steam_cb_length, steam_cb_read, steam_cb_seek, "callback data"));
	assert(steam_callback_closed);
	assert(abs(s.length - 1634) < 60, "length " + s.length);
}

float[] steam_sine(int rate, int channels, float seconds) {
	float[] samples(uint(rate * seconds) * channels);
	for (uint i = 0; i < samples.length(); i++) samples[i] = sin(6.2832 * 440 * (i / channels) / rate) * 0.5;
	return samples;
}

void test_steam_sound_push_pcm() {
	steam::mixer m;
	m.volume = -100;
	steam::sound s;
	assert(s.set_mixer(m));
	assert(!s.push_memory(steam_sine(24000, 1, 0.1))); // The first push must say what the samples are.
	float[] half = steam_sine(24000, 1, 0.25);
	assert(s.push_memory(half, false, 24000, 1));
	assert(s.active && s.loaded_filename == "");
	assert(abs(s.length - 250) < 5, "buffered " + s.length);
	assert(s.push_memory(half)); // Later pushes keep the stream's format.
	datastream ds; // The string form takes the same samples as raw 32 bit floats.
	for (uint i = 0; i < half.length(); i++) ds.write_float(half[i]);
	assert(s.push_memory(ds.str(), true));
	assert(abs(s.length - 750) < 5, "buffered " + s.length);
	if (!steam::SOUND_AVAILABLE) return;
	assert(s.play());
	timer t;
	while (s.playing && t.elapsed < 3000) wait(10);
	assert(!s.playing, "a pushed stream that was ended never finished");
	assert(t.elapsed > 600 && t.elapsed < 1200, "750ms of audio took " + t.elapsed + "ms");
	steam::sound open_ended;
	assert(open_ended.set_mixer(m));
	assert(open_ended.push_memory(half, false, 24000, 1));
	assert(open_ended.play());
	wait(500);
	assert(open_ended.playing); // Ran dry but wasn't ended, so it waits for more.
	assert(open_ended.push_memory(half, true));
	t.restart();
	while (open_ended.playing && t.elapsed < 2000) wait(10);
	assert(!open_ended.playing);
}

void test_steam_sound_push_encoded() {
	string data = steam_read_file("data/audio/yfs.ogg");
	steam::sound s;
	assert(!s.push_memory(data.substr(0, 500))); // Too little to recognise, as under BASS.
	assert(s.push_memory(data.substr(0, 4096)));
	for (uint pos = 4096; pos < data.length(); pos += 4096) assert(s.push_memory(data.substr(pos, 4096), pos + 4096 >= data.length()));
	assert(s.active);
	if (!steam::SOUND_AVAILABLE) return;
	steam::mixer m;
	m.volume = -100;
	assert(s.set_mixer(m));
	assert(s.play());
	timer t;
	while (s.playing && t.elapsed < 4000) wait(10);
	assert(!s.playing, "pushed ogg never finished");
	assert(t.elapsed > 1300, "1634ms of pushed ogg finished after " + t.elapsed + "ms");
	assert(s.close());
}

// Phase 2b: set_fx. The DSP itself is checked numerically outside the engine; these check the legacy rules and that effects run in the mix.
void test_steam_sound_set_fx_rules() {
	steam::sound s;
	assert(s.load("data/audio/yfs.ogg"));
	assert(s.set_fx("lowpass:1200:0:0.7"));
	assert(!s.set_fx("lowpass:1200:0")); // Too few parameters.
	assert(!s.set_fx("flanger:0.5:0.002")); // Not an effect.
	assert(!s.set_fx(":::")); // Nothing but separators.
	assert(s.set_fx("$muffle:lowpass:800:0:0.7"));
	assert(s.set_fx("$muffle:highpass:200:0:0.7")); // Same id, same family: changed in place.
	assert(!s.set_fx("$muffle:freeverb:0:1:0.5:0.5:1")); // Same id, different type.
	assert(s.set_fx("$room_a:freeverb:1:0.5:0.5:0.5:1"));
	assert(s.set_fx("$room_b:plate:1:0.3:1:0.6:0.4"));
	assert(s.set_fx("$room")); // Prefix removal takes both rooms.
	assert(!s.set_fx("$room_a:lowpass:800:0")); // Proves the id is free again only if the effect itself is valid.
	assert(s.set_fx("$room_a:volume:0.9", 0)); // Inserted at the front.
	assert(s.set_fx("", 0)); // Removes it.
	assert(!s.set_fx("", 50)); // No such index.
	assert(s.set_fx("")); // Clears everything.
	assert(s.set_fx("$x:volume:1"));
}

void test_steam_sound_effects_in_the_mix() {
	steam::mixer m;
	m.volume = -100;
	assert(m.set_fx("$verb:freeverb:1:0.5:0.6:0.5:1"));
	assert(m.set_fx("i3DL2reverb:-1000:-100:0:1.49:0.83:-2602:0.007:200:0.011:100:100:5000"));
	assert(m.set_fx("reverb:0:-10:1200:0.5"));
	assert(m.set_fx("damp:0.8:0.01:0.3:1:0.5"));
	steam::sound s;
	assert(s.set_mixer(m));
	assert(s.load("data/audio/yfs.wav"));
	assert(s.set_fx("$f:bandpass:1000:2:0"));
	assert(s.set_fx("rotate:0.5"));
	assert(s.set_fx("lvolume:0.8"));
	assert(s.set_fx("plate:1:0.4:1.2:0.7:0.3:1:0.02"));
	// Phase 4, in BASS_FX's own preset values.
	assert(s.set_fx("echo4:1:0.5:0.4:0.15:1"));
	assert(s.set_fx("chorus:1:0.35:0.5:1:5:1"));
	assert(s.set_fx("phaser:0.999:0.999:0:1:4:100"));
	assert(s.set_fx("$w:autowah:0.5:1.5:0.5:2:4.3:50"));
	assert(s.set_fx("distortion:0.2:0.96:0.03:0.1:1"));
	assert(s.set_fx("compressor2:5:-15:3:10:300"));
	assert(s.set_fx("$p:pitchshift:1:3"));
	assert(!s.set_fx("echo4:1:0.5:0.4:0.15")); // Each still needs its legacy parameter count.
	assert(!s.set_fx("$p:chorus:1:0.35:0.5:1:5:1")); // $p is a pitchshift.
	if (!steam::SOUND_AVAILABLE) return;
	assert(s.play());
	wait(200);
	for (int i = 0; i < 20; i++) {
		assert(s.set_fx("$f:bandpass:" + (500 + i * 100) + ":2:0")); // Adjusting a running filter, as games do every frame.
		assert(s.set_fx("$p:pitchshift:" + (0.8 + i * 0.02))); // And a running pitch shift.
	}
	timer t;
	while (s.playing && t.elapsed < 4000) wait(10);
	assert(!s.playing, "a sound with effects never finished");
	assert(m.set_fx(""));
}

// Phase 3: Steam Audio. HRTF placement is checked numerically outside the engine; this checks it runs in the mix.
void test_steam_sound_hrtf_plays() {
	if (!steam::SOUND_AVAILABLE) return;
	steam::sound_global_hrtf = true;
	assert(steam::sound_global_hrtf);
	steam::mixer m;
	m.volume = -100;
	steam::sound s;
	assert(s.set_mixer(m));
	assert(s.load("data/audio/yfs.wav"));
	s.set_hrtf(true);
	assert(s.set_position(0, 0, 0, 5, 3, 0));
	assert(s.play());
	timer t;
	for (int i = 0; s.playing && t.elapsed < 4000; i++) {
		s.set_position(0, 0, 0, cos(i * 0.1) * 5, sin(i * 0.1) * 5, 0, i * 0.05); // Moving and turning while it plays.
		wait(10);
	}
	assert(!s.playing, "an HRTF sound never finished");
	steam::mixer positioned; // Mixers can be placed too.
	assert(positioned.set_mixer(m));
	positioned.set_hrtf(true);
	assert(positioned.set_position(0, 0, 0, -4, 0, 0));
	assert(s.set_mixer(positioned));
	s.pitch = 150; // A pitched sound under an HRTF mixer.
	assert(s.play());
	t.restart();
	while (s.playing && t.elapsed < 4000) wait(10);
	assert(!s.playing);
}

// sound_environment. Occlusion, transmission and reflections are checked numerically against real Steam Audio scenes outside the engine; this checks the script side.
void test_steam_sound_environment() {
	steam::sound_environment env;
	assert(steam::sound_global_hrtf); // Turned on by creating an environment, as in the legacy engine.
	assert(env.add_material("felt", 0.5, 0.6, 0.7, 0.05, 0.3, 0.2, 0.1));
	assert(!env.add_material("felt", 0, 0, 0, 0, 0, 0, 0)); // Already there.
	assert(env.add_material("felt", 0, 0, 0, 0, 0, 0, 0, true)); // Unless asked to replace it.
	assert(env.add_box("concrete", -10, 10, -10, 10, -1, 0)); // A floor.
	assert(!env.add_box("unobtainium", 0, 1, 0, 1, 0, 1));
	env.set_listener(0, 0, 0, 0);
	steam::sound@ s = env.new_sound();
	assert(s !is null);
	steam::mixer@ m = env.new_mixer();
	assert(m !is null);
	if (!steam::SOUND_AVAILABLE) return;
	steam::mixer quiet;
	quiet.volume = -100;
	assert(s.set_mixer(quiet));
	assert(s.load("data/audio/yfs.wav"));
	assert(s.set_position(0, 0, 0, 4, 2, 0));
	assert(s.play());
	timer t;
	for (int i = 0; s.playing && t.elapsed < 4000; i++) {
		env.set_listener(0, i * 0.01, 0, 0);
		env.update();
		wait(10);
	}
	assert(!s.playing, "a sound in an environment never finished");
	@s = null; // Releasing sounds detaches them from the environment.
	@m = null;
}

// set_impulse_response. The convolver is checked against direct convolution outside the engine; this checks the script side. hall_ir.wav is a synthesized 1.2 second stereo response.
void test_steam_sound_impulse_response() {
	steam::mixer m;
	assert(m.set_impulse_response("data/audio/hall_ir.wav"));
	assert(m.set_impulse_response("data/audio/hall_ir.wav", 1.0, 0.5, "data/audio/yfs.wav", 0.5)); // A second file makes it true stereo.
	// A real recorded response, 24 bit at 44.1 kHz so it is resampled on load. It isn't in the repository, so this only runs where it has been copied in.
	if (file_exists("data/audio/sedan_speakers_front.wav")) assert(m.set_impulse_response("data/audio/sedan_speakers_front.wav", 0.0, 0.3));
	assert(!m.set_impulse_response("data/audio/no_such_response.wav"));
	assert(!m.set_impulse_response("data/audio/hall_ir.wav", 1, 0.3, "data/audio/no_such_right.wav"));
	assert(m.set_impulse_response_params(0.8, 0.4, 0.0)); // Centred tail.
	steam::set_impulse_response_quality(0.5, 2); // Cheaper responses from here on.
	assert(m.set_impulse_response("data/audio/hall_ir.wav"));
	steam::set_impulse_response_quality(1.5, 3); // 3 isn't a power of two, so loading refuses it.
	assert(!m.set_impulse_response("data/audio/hall_ir.wav"));
	steam::set_impulse_response_quality();
	assert(m.set_impulse_response("data/audio/hall_ir.wav"));
	if (steam::SOUND_AVAILABLE) {
		steam::mixer quiet;
		quiet.volume = -100;
		assert(m.set_mixer(quiet));
		steam::sound s;
		assert(s.set_mixer(m));
		assert(s.load("data/audio/yfs.ogg"));
		assert(s.play());
		timer t;
		while (s.playing && t.elapsed < 4000) {
			m.set_impulse_response_params(1, 0.2 + t.elapsed / 10000.0, 1); // Eased every frame, as games do with distance.
			wait(10);
		}
		assert(!s.playing);
	}
	assert(m.set_impulse_response("")); // Off.
}
