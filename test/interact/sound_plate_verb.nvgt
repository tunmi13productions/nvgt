audio_plate_reverb_node plate;
reverb3d@ verb;

void describe() {
	screen_reader_speak("size " + plate.size + ", decay " + plate.decay + ", damping " + plate.damping + ", predelay " + plate.predelay + ", tail " + plate.decay_time_in_frames + " frames", true);
}

void main() {
	show_window("test");
	set_sound_global_hrtf(true);
	plate.size = 1.2;
	plate.decay = 0.7;
	plate.damping = 0.4;
	plate.predelay = 0.02;
	@verb = reverb3d(plate);
	verb.max_audible_distance = 200;
	sound@ snd = sound_play("C:/windows/media/Ring10.wav", autoplay = false);
	snd.set_position_3d(5, 5, 0);
	if (!snd.set_shape(sound_aabb_shape(0, 5, 0, 5, 0, 1))) alert("warning", "shape set fail");
	@snd.reverb3d = verb;
	snd.play_looped();
	while (!key_pressed(KEY_ESCAPE)) {
		wait(5);
		vector l = sound_get_listener_position();
		bool moved = true;
		if (key_pressed(KEY_LEFT)) l.x--;
		else if (key_pressed(KEY_RIGHT)) l.x++;
		else if (key_pressed(KEY_DOWN)) l.y--;
		else if (key_pressed(KEY_UP)) l.y++;
		else moved = false;
		if (moved) {
			sound_set_listener_position(l);
			sound@ step = sound_play("C:/windows/media/chord.wav", autoplay = false);
			@step.reverb3d = verb;
			step.play();
		}
		// Decay and damping are safe to sweep while audio runs, so they are on the arrow-free keys.
		if (key_pressed(KEY_A)) { plate.decay = dmax(0.0, plate.decay - 0.1); describe(); }
		else if (key_pressed(KEY_S)) { plate.decay = dmin(0.999, plate.decay + 0.1); describe(); }
		else if (key_pressed(KEY_D)) { plate.damping = dmax(0.0, plate.damping - 0.1); describe(); }
		else if (key_pressed(KEY_F)) { plate.damping = dmin(1.0, plate.damping + 0.1); describe(); }
		// Size retunes every delay at once, so it clicks. It is a setting, not a sweep.
		else if (key_pressed(KEY_G)) { plate.size = dmax(0.1, plate.size - 0.2); describe(); }
		else if (key_pressed(KEY_H)) { plate.size = dmin(2.0, plate.size + 0.2); describe(); }
		else if (key_pressed(KEY_SPACE)) { plate.frozen = !plate.frozen; screen_reader_speak(plate.frozen? "frozen" : "thawed", true); }
	}
}
