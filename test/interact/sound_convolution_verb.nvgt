audio_convolution_reverb_node conv;
reverb3d@ verb;

void describe() {
	screen_reader_speak("wet " + conv.wet + ", dry " + conv.dry + ", ir " + (conv.ir_loaded? conv.ir_length_ms + " ms" : "not loaded"), true);
}

void main() {
	show_window("test");
	set_sound_global_hrtf(true);
	string ir_path = input_box("convolution reverb", "path to an impulse response file (wav, flac, ogg...)", "");
	if (ir_path == "" || !conv.load_ir(ir_path)) {
		alert("error", "could not load impulse response");
		return;
	}
	conv.wet = 1.0;
	conv.dry = 0.0;
	@verb = reverb3d(conv);
	verb.max_audible_distance = 200;
	sound@ snd = sound_play("C:/windows/media/Ring10.wav", autoplay = false);
	snd.set_position_3d(5, 5, 0);
	if (!snd.set_shape(sound_aabb_shape(0, 5, 0, 5, 0, 1))) alert("warning", "shape set fail");
	@snd.reverb3d = verb;
	snd.play_looped();
	describe();
	while (!key_pressed(KEY_ESCAPE)) {
		wait(5);
		vector l = sound_get_listener_position();
		bool moved = true;
		if (key_pressed(KEY_LEFT)) l.x--;
		else if (key_pressed(KEY_RIGHT)) l.x++;
		else if (key_pressed(KEY_DOWN)) l.y--;
		else if (key_pressed(KEY_UP)) l.y++;
		else moved = false;
		if (moved) {
			sound_set_listener_position(l);
			sound@ step = sound_play("C:/windows/media/chord.wav", autoplay = false);
			@step.reverb3d = verb;
			step.play();
		}
		// Wet and dry are safe to sweep while audio runs.
		if (key_pressed(KEY_A)) { conv.wet = dmax(0.0, conv.wet - 0.1); describe(); }
		else if (key_pressed(KEY_S)) { conv.wet = dmin(1.0, conv.wet + 0.1); describe(); }
		else if (key_pressed(KEY_D)) { conv.dry = dmax(0.0, conv.dry - 0.1); describe(); }
		else if (key_pressed(KEY_F)) { conv.dry = dmin(1.0, conv.dry + 0.1); describe(); }
	}
}
