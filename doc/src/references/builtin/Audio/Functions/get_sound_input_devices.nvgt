/**
	Return an array of strings listing all input sound devices on the system.
	string[]@ get_sound_input_devices();
	## Returns:
		string[]@: A handle to an array listing all available input devices.
	## Remarks:
		The position of a device in this array is its index, to set sound_input_device to or pass to a microphone. Unlike output devices, the list holds only real devices; to go back to the system default, set sound_input_device to 0xffffffff.
*/

// Example:
void main() {
	string[]@ devices = get_sound_input_devices();
	alert("devices", "The following input devices are installed on your system: " + join(devices, ", "));
}
